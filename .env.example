# ─── Configuración de entorno — Call Center Analytics ───────────────────────
# Copia este archivo a `.env` y completa los valores. NO commitees el .env real.

# URL base de la API backend (incluye /api)
API_URL=http://192.168.11.3/api

# Versión de la API
API_VERSION=v1

# WebSocket (tiempo real), si aplica
WS_URL=ws://192.168.11.3

# Entorno: development | staging | production
APP_ENV=development
